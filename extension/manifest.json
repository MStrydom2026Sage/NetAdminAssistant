{
  "manifest_version": 3,
  "name": "NetAdmin Assistant - Sage 300 Support Helper",
  "version": "0.8.0",
  "description": "Local Sage 300 ticket analysis with optional, explicitly requested live AI research through a local helper.",
  "author": "MStrydom2026",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "https://netadmin.sage.co.za/*",
    "https://*.sage.co.za/*",
    "https://za-kb.sage.com/*",
    "https://us-kb.sage.com/*",
    "https://communityhub.sage.com/*"
  ],
  "action": {
    "default_title": "NetAdmin Assistant"
  },
  "side_panel": {
    "default_path": "html/sidepanel.html",
    "default_title": "NetAdmin Analysis"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://netadmin.sage.co.za/*",
        "https://*.sage.co.za/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://communityhub.sage.com/*"],
      "js": ["community-search.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["html/sidepanel.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
