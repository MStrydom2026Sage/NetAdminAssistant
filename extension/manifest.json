{
  "manifest_version": 3,
  "name": "NetAdmin Assistant - Sage 300 Support Helper",
  "version": "0.7.6",
  "description": "Offline rules analysis for Sage 300 support tickets. No AI service, API key or helper server required.",
  "author": "MStrydom2026",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://netadmin.sage.co.za/*",
    "https://*.sage.co.za/*",
    "https://za-kb.sage.com/*",
    "https://us-kb.sage.com/*",
    "https://communityhub.sage.com/*"
  ],
  "action": {
    "default_title": "NetAdmin Assistant"
  },
  "side_panel": {
    "default_path": "html/sidepanel.html",
    "default_title": "NetAdmin Analysis"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://netadmin.sage.co.za/*",
        "https://*.sage.co.za/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["html/sidepanel.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
