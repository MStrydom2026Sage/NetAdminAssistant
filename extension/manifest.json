{
  "manifest_version": 3,
  "name": "NetAdmin Assistant - Sage 300 Support Helper",
  "version": "0.5.4",
  "description": "Offline rules engine for Sage support tickets. No server or API key required.",
  "author": "MStrydom2026",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://netadmin.sage.co.za/*",
    "https://*.sage.co.za/*"
  ],
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "NetAdmin Assistant"
  },
  "side_panel": {
    "default_path": "html/sidepanel.html",
    "default_title": "NetAdmin Analysis"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://netadmin.sage.co.za/*",
        "https://*.sage.co.za/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
